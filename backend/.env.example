# PostgreSQL connection
DATABASE_URL=postgresql://campusai:campusai@localhost:5432/campusai

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
PROJECT_NAME=CampusAI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API.
# Add your Vercel URL here once deployed, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://campusai.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# AI provider (OpenAI-compatible) — leave OPENAI_API_KEY unset to run
# everything except /documents and /chat; those return 503 until configured.
# Point OPENAI_BASE_URL at a local/compatible server (e.g. Ollama's OpenAI
# shim) if you'd rather not use OpenAI directly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
